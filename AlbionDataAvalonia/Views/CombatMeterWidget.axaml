<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
             xmlns:views="clr-namespace:AlbionDataAvalonia.Views"
             x:Class="AlbionDataAvalonia.Views.CombatMeterWidget" x:DataType="vm:CombatMeterViewModel">
    <!-- Widget rows are display-only and deliberately denser than the application's selectable lists. -->
    <UserControl.Styles>
        <Style Selector="ListBox.MeterRanking"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style Selector="ListBox.MeterRanking ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,2" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /></Style>
        <Style Selector="ListBox.MeterRanking ListBoxItem:selected"><Setter Property="Background" Value="Transparent" /></Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="2">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" PointerPressed="Drag_PointerPressed"
                        ToolTip.Tip="{Binding WidgetHelp}">
                <Ellipse Classes="UiStatusDot" Classes.Ok="{Binding IsLive}" Classes.Busy="{Binding !IsLive}" />
                <TextBlock Classes="UiRowTitle" Text="{Binding WidgetScopeTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button Classes="UiGhost" Content="{Binding PauseGlyph}" Command="{Binding TogglePauseCommand}" Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0"
                        ToolTip.Tip="{Binding PauseText}" AutomationProperties.Name="Pause or resume statistics" />
                <Button Classes="UiGhost" Content="↺" Command="{Binding ResetCommand}" Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0"
                        ToolTip.Tip="Reset this meter" AutomationProperties.Name="Reset statistics" />
                <Button Classes="UiGhost" Content="↗" Command="{Binding ExpandWindowCommand}" Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0"
                        ToolTip.Tip="Open full statistics and settings" AutomationProperties.Name="Open full statistics and settings" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="4">
            <TextBlock Classes="UiFine" Text="{Binding WidgetPeriodText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" ToolTip.Tip="{Binding PeriodText}" />
            <Button Grid.Column="1" Classes="UiLink" Content="{Binding MetricTitle}" Command="{Binding CycleMetricCommand}" Padding="0" MinHeight="0"
                    ToolTip.Tip="Change the player ranking metric; all four totals stay visible" AutomationProperties.Name="Change player ranking metric" />
        </Grid>
        <views:CombatMeterTotalsView Grid.Row="2" />
        <TextBlock Grid.Row="3" Classes="UiFine" Text="{Binding WidgetContributionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding ContributionHeader.PersonalDetail}" />
        <Grid Grid.Row="4">
            <ListBox Classes="MeterRanking" ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}" Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Combat contribution ranking">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CombatMeterDisplayRow">
                        <Border Classes="UiCard Subtle" Padding="4,2" ToolTip.Tip="{Binding DetailTip}">
                            <Grid ColumnDefinitions="16,*,Auto" RowDefinitions="Auto,2" ColumnSpacing="4" RowSpacing="2">
                                <TextBlock Classes="UiCaption" Text="{Binding Rank}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="UiLabel" Classes.UiAccent="{Binding IsPersonal}" Text="{Binding Name}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Classes="UiRowTitle" FontSize="{DynamicResource UiFontSizeSmall}" Text="{Binding WidgetRankingValue}" />
                                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Value="{Binding ShareValue}" Minimum="0" Maximum="100" Height="2" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Classes="UiFine" Text="No players for this ranking metric" TextWrapping="Wrap" IsVisible="{Binding !HasRows}" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="5" ColumnDefinitions="*,12">
            <TextBlock Classes="UiWarning" Text="{Binding Error}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Error}" />
            <Border Grid.Column="1" Height="10" Width="12" Background="Transparent" Cursor="SizeWestEast" PointerPressed="Resize_PointerPressed"
                    ToolTip.Tip="Resize widget"><TextBlock Classes="UiFine" Text="◢" HorizontalAlignment="Right" /></Border>
        </Grid>
    </Grid>
</UserControl>
