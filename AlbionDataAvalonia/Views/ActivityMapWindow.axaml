<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AlbionDataAvalonia.ViewModels"
        xmlns:views="clr-namespace:AlbionDataAvalonia.Views"
        xmlns:controls="using:AlbionDataAvalonia.Views.Controls"
        x:Class="AlbionDataAvalonia.Views.ActivityMapWindow" Classes="AppPage"
        x:DataType="vm:ActivityMapViewModel"
        Title="AFM Map" Icon="/Assets/logo.ico"
        Width="980" Height="700" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource UiWindowBrush}">
    <!-- Zoom buttons are drawn over the map. -->
    <Window.Styles>
        <Style Selector="Button.MapTool">
            <Setter Property="Background" Value="{DynamicResource UiOverlayBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSection}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border BorderBrush="{DynamicResource UiDividerBrush}" BorderThickness="0,0,0,1" Padding="12,8,12,4">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <controls:SegmentedSelector ItemsSource="{Binding ModeOptions}" SelectedIndex="{Binding SelectedModeIndex}"
                                                 AutomationProperties.Name="Map mode" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,0,4">
                    <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" IsVisible="{Binding IsHistory}"
                              MinWidth="260" MaxWidth="420" AutomationProperties.Name="Run" PlaceholderText="No runs with positions yet">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActivityMapRunOption">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding RunMaps}" SelectedItem="{Binding SelectedRunMap}" MinWidth="150"
                              IsVisible="{Binding HasMultipleRunMaps}" AutomationProperties.Name="Map in this run">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActivityMapRunMapOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Classes="UiSectionTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Classes="UiLabel"
                                   IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <controls:SegmentedSelector ItemsSource="{Binding ScopeOptions}" SelectedIndex="{Binding SelectedScopeIndex}"
                                                     AutomationProperties.Name="Events shown"
                                                     ToolTip.Tip="Personal shows your own events. Party adds your party's, with a light ring, placed where you were when the client saw them. The path is always yours." />
                    <TextBlock Text="Fade after" Classes="UiLabel" VerticalAlignment="Center" Margin="8,0,0,4" IsVisible="{Binding IsLive}" />
                    <controls:SegmentedSelector ItemsSource="{Binding FadeOptions}" SelectedIndex="{Binding SelectedFadeIndex}"
                                                     AutomationProperties.Name="Fade path and events after" IsVisible="{Binding IsLive}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <views:ActivityMapCanvas x:Name="MapCanvas" Scene="{Binding Scene}" Follow="{Binding Follow, Mode=TwoWay}" />

            <Border Classes="UiOverlay" IsVisible="{Binding HasNote}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" MaxWidth="460">
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="{DynamicResource UiFontSizeSmall}" />
            </Border>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" IsVisible="{Binding ShowFollow}">
                <Border Classes="UiOverlay" IsVisible="{Binding Follow}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="UiStatusDot Busy" />
                        <TextBlock Text="Following you" FontSize="{DynamicResource UiFontSizeSmall}" />
                    </StackPanel>
                </Border>
                <Button Content="Follow me" Command="{Binding FollowMeCommand}" IsVisible="{Binding !Follow}" FontSize="{DynamicResource UiFontSizeSmall}"
                        Background="{DynamicResource UiOverlayBrush}" ToolTip.Tip="Keep your character in the middle of the map" />
            </StackPanel>

            <Border Classes="UiOverlay" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" MaxWidth="420" MaxHeight="480" Padding="12">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="Map filters" Classes="UiSectionTitle" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="UiGhost" Command="{Binding ToggleLegendCommand}"
                                AutomationProperties.Name="Show or hide map filters">
                            <Panel>
                                <TextBlock Text="Hide" IsVisible="{Binding !LegendCollapsed}" />
                                <TextBlock Text="Show" IsVisible="{Binding LegendCollapsed}" />
                            </Panel>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding !LegendCollapsed}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Layers" Classes="UiLabel" />
                <WrapPanel MaxWidth="380">
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowPath}" ToolTip.Tip="Show or hide your path">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="16" Height="4" CornerRadius="2" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                        <GradientStop Color="{DynamicResource UiMapPathStartColor}" Offset="0" />
                                        <GradientStop Color="{DynamicResource UiMapPathMiddleColor}" Offset="0.5" />
                                        <GradientStop Color="{DynamicResource UiMapPathEndColor}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="Path" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowKills}" ToolTip.Tip="Mobs and players killed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M5,0 L10,5 L5,10 L0,5 Z" Fill="{DynamicResource UiActivityKillBrush}" Stroke="{DynamicResource UiMarkerOutlineBrush}" StrokeThickness="1" VerticalAlignment="Center" />
                            <TextBlock Text="Kills" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowLoot}" ToolTip.Tip="Items picked up">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource UiActivityLootBrush}" Stroke="{DynamicResource UiMarkerOutlineBrush}" StrokeThickness="1" VerticalAlignment="Center" />
                            <TextBlock Text="Loot" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowGathering}" ToolTip.Tip="Resources gathered and fish caught">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M5,0 L10,9 L0,9 Z" Fill="{DynamicResource UiActivityGatheringBrush}" Stroke="{DynamicResource UiMarkerOutlineBrush}" StrokeThickness="1" VerticalAlignment="Center" />
                            <TextBlock Text="Gathering" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowDeaths}" ToolTip.Tip="Deaths and knockdowns">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{DynamicResource UiActivityDeathBrush}" StrokeThickness="2" VerticalAlignment="Center" />
                            <TextBlock Text="Deaths" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowFeatures}" ToolTip.Tip="Zone exits and the game's minimap icons">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource UiMapExitBrush}" Stroke="{DynamicResource UiMarkerOutlineBrush}" StrokeThickness="1" VerticalAlignment="Center" />
                            <TextBlock Text="Exits &amp; icons" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowResources}" IsVisible="{Binding IsLive}"
                                  ToolTip.Tip="Resource nodes the game has shown near you on this map, with their tier and the units left under each. A colored ring marks an enchanted node. Empty nodes disappear immediately; sightings are cleared when you change zone.">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource UiResourceWoodBrush}" VerticalAlignment="Center" />
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource UiResourceOreBrush}" VerticalAlignment="Center" />
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource UiResourceFiberBrush}" VerticalAlignment="Center" />
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource UiResourceHideBrush}" VerticalAlignment="Center" />
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource UiResourceStoneBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Seen resources" Margin="4,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowResourceSpawns}"
                                  ToolTip.Tip="Where this zone can grow resource nodes and resource mobs, from the game files, like the interactive maps on the web. Squares are nodes and hollow diamonds are mobs, with the tier inside. These are possible spots, not what stands there now, and they need no packet reading.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource UiResourceFiberBrush}" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Text="Spawn spots" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowPois}"
                                  ToolTip.Tip="This zone's points of interest from the game files, in one layer: loot chests (gold: open-world camp, faction and static chests, Corrupted Dungeon and Hellgate chests, Knightfall Abbey's boss chests, and in the Mists the layout's camp slots with a ring where a camp's chest stands), boss spawn spots (red diamonds), shrines (violet triangles), mob camp spots (orange squares), Mists wisp spawns (blue dots). The Depths have no minimap, so each floor is drawn from the game files: a rough outline of its ground, its camp rooms, demon altars (red-orange discs), treasure chest (gold) and coffer (silver) spots, key spawns (gold rings), and exits up (green) and down (blue). Roads chests show as the game's own icons under Exits &amp; icons. These are possible spots, not what stands there now.">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Width="11" Height="8" CornerRadius="2" Background="{DynamicResource UiMapChestBrush}" VerticalAlignment="Center" />
                            <Path Data="M5,0 L10,5 L5,10 L0,5 Z" Fill="{DynamicResource UiMapPoiBossBrush}" VerticalAlignment="Center" />
                            <Path Data="M5,0 L10,9 L0,9 Z" Fill="{DynamicResource UiMapPoiShrineBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Points of interest" Margin="2,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowRoamingBosses}" IsVisible="{Binding IsLive}"
                                  ToolTip.Tip="Roaming bosses and minibosses the game has shown near you, with their portrait and tier. They follow the bosses as they move and go when the game says they left or died. Read from the game's packets, like the resource nodes.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="10" Height="10" Stroke="{DynamicResource UiMapPoiBossBrush}" StrokeThickness="2" VerticalAlignment="Center" />
                            <TextBlock Text="Roaming bosses" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowHostileAlert}" IsVisible="{Binding IsLive}"
                                  ToolTip.Tip="Flashes a red exclamation mark over you for 3 seconds when a player outside your party, guild and alliance comes into view. The game encrypts where other players stand, so the map can't show them, only that one arrived. Off in blue zones.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="13" Height="13" CornerRadius="7" Background="{DynamicResource UiMapHostileBrush}" VerticalAlignment="Center">
                                <TextBlock Text="!" FontSize="{StaticResource UiFontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource UiMapHostileTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Hostile alert" />
                        </StackPanel>
                    </ToggleButton>
                </WrapPanel>
                            </StackPanel>
                            <Border Classes="UiCard Subtle" Padding="10" IsVisible="{Binding ShowResourceFilters}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Resource kinds" Classes="UiLabel" />
                                    <WrapPanel MaxWidth="360">
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowWood}" ToolTip.Tip="Show or hide trees and wood critters">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource UiResourceWoodBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Wood" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowOre}" ToolTip.Tip="Show or hide ore veins and ore critters">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource UiResourceOreBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Ore" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowFiber}" ToolTip.Tip="Show or hide fiber plants and fiber critters">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource UiResourceFiberBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Fiber" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowHide}" ToolTip.Tip="Show or hide hide animals and skinnable remains">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource UiResourceHideBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Hide" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowStone}" ToolTip.Tip="Show or hide rocks and stone critters">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource UiResourceStoneBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Stone" />
                        </StackPanel>
                    </ToggleButton>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Classes="UiCard Subtle" Padding="10" IsVisible="{Binding ShowResourceTier}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Seen resources" Classes="UiSectionTitle" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="Minimum seen tier" Classes="UiLabel" />
                                <ComboBox ItemsSource="{Binding ResourceTierOptions}" SelectedItem="{Binding SelectedResourceTier}"
                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Minimum seen tier" ToolTip.Tip="Show seen resources of this tier and higher" />
                            </StackPanel>
                                    <TextBlock Text="Include resources below this tier" Classes="UiMuted" TextWrapping="Wrap" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Lower tiers" Classes="UiLabel" />
                                        <ComboBox ItemsSource="{Binding LowerTierOptions}" SelectedItem="{Binding SelectedLowerTiers}"
                                                  HorizontalAlignment="Stretch" AutomationProperties.Name="Lower tiers"
                                                  ToolTip.Tip="Choose how many tiers below the target can appear, then set enchantment separately for each" />
                                    </StackPanel>
                                    <!-- At most seven fixed tier offsets; each row labels its current absolute tier. -->
                                    <ItemsControl ItemsSource="{Binding ResourceTierFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ActivityMapResourceTierFilterViewModel">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Label}" Classes="UiLabel" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding EnchantmentOptions}"
                                                              SelectedItem="{Binding SelectedEnchantment}" MinWidth="112"
                                                              AutomationProperties.Name="{Binding Label}"
                                                              ToolTip.Tip="Show this enchantment and higher for this tier. Applies to seen nodes and resource mobs." />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                    <ToggleButton Classes="UiLegend" IsChecked="{Binding ShowResourceMobs}" IsVisible="{Binding ShowResourceTier}"
                                  ToolTip.Tip="Also show the mobs near you that yield resources, such as hide animals and ore, wood, fiber and stone critters, as diamonds in their resource's color with the tier inside. They follow the mobs as they move.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M5,0 L10,5 L5,10 L0,5 Z" Fill="{DynamicResource UiResourceHideBrush}" Stroke="{DynamicResource UiMarkerOutlineBrush}" StrokeThickness="1" VerticalAlignment="Center" />
                            <TextBlock Text="Mobs" />
                        </StackPanel>
                    </ToggleButton>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Seen resource opacity" Classes="UiLabel" />
                                        <ComboBox ItemsSource="{Binding IconOpacityOptions}" SelectedItem="{Binding SelectedIconOpacity}"
                                                  HorizontalAlignment="Stretch" AutomationProperties.Name="Seen resource opacity"
                                                  ToolTip.Tip="Opacity of seen resource nodes, resource mobs and their labels" />
                                    </StackPanel>
                                    <TextBlock Text="Empty nodes are hidden. Sightings last only for this visit." Classes="UiFine" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Classes="UiCard Subtle" Padding="10" IsVisible="{Binding ShowResourceSpawns}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Possible spawn spots" Classes="UiSectionTitle" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="Minimum spawn tier" Classes="UiLabel" />
                                <ComboBox ItemsSource="{Binding ResourceTierOptions}" SelectedItem="{Binding SelectedResourceSpawnTier}"
                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Minimum spawn tier" ToolTip.Tip="Independent of the seen-resource tier and enchantment filters" />
                            </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Spawn spot opacity" Classes="UiLabel" />
                                        <ComboBox ItemsSource="{Binding IconOpacityOptions}" SelectedItem="{Binding SelectedSpawnIconOpacity}"
                                                  HorizontalAlignment="Stretch" AutomationProperties.Name="Spawn spot opacity"
                                                  ToolTip.Tip="Opacity of possible node and resource-mob spawn spots and their labels; independent of seen resources" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Classes="UiCard Subtle" Padding="10" IsVisible="{Binding ShowResourceFilters}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Resource icons" Classes="UiSectionTitle" />
                                    <TextBlock Text="Applies to seen resources and possible spawn spots." Classes="UiFine" TextWrapping="Wrap" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="Icon size" Classes="UiLabel" />
                                <ComboBox ItemsSource="{Binding IconSizeOptions}" SelectedItem="{Binding SelectedIconSize}"
                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Icon size" ToolTip.Tip="Scale resource markers, labels and hover areas" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Grouping radius" Classes="UiLabel" />
                                <ComboBox ItemsSource="{Binding ClusterRadiusOptions}" SelectedItem="{Binding SelectedClusterRadius}"
                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Grouping radius" ToolTip.Tip="Screen pixels between grouped nodes or spawn spots; Off shows each separately" />
                            </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Spacing="6">
                <Button Classes="UiIcon MapTool" Content="+" Click="ZoomIn_Click" ToolTip.Tip="Zoom in" AutomationProperties.Name="Zoom in" />
                <Button Classes="UiIcon MapTool" Content="−" Click="ZoomOut_Click" ToolTip.Tip="Zoom out" AutomationProperties.Name="Zoom out" />
                <Button Classes="UiIcon MapTool" Content="⤢" FontSize="{DynamicResource UiFontSizeCompact}" Click="Fit_Click" ToolTip.Tip="Fit to view" AutomationProperties.Name="Fit to view" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" IsVisible="{Binding IsHistory}" BorderBrush="{DynamicResource UiDividerBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                <Button Content="{Binding PlayButtonText}" Command="{Binding TogglePlayCommand}" Width="34" Height="34" CornerRadius="17"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Replay this run"
                        AutomationProperties.Name="{Binding PlayButtonName}" />
                <TextBlock Grid.Column="1" Text="{Binding TimelineStartText}" Classes="UiLabel" VerticalAlignment="Center" />
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <views:ActivityMapTimelineTicks Ticks="{Binding Ticks}" Height="14" VerticalAlignment="Center" Opacity="0.85" />
                    <Slider Minimum="0" Maximum="{Binding TimelineMaximum}" Value="{Binding TimelineValue}" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding TimelineNowText}" AutomationProperties.Name="Replay position" />
                </Grid>
                <TextBlock Grid.Column="3" Text="{Binding TimelineEndText}" Classes="UiLabel" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding RunSummaryText}" Classes="UiLabel" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
